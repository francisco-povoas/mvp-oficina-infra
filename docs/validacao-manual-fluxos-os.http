POST {{financeiro}}/api/v1/quotes/{{orcamentoBId}}/communicate
Authorization: Bearer {{tokenAtendente}}
Content-Type: application/json

{
  "communication_id": "{{$guid}}",
  "evidences": [
    {
      "evidence_id": "{{$guid}}",
      "channel": "EMAIL",
