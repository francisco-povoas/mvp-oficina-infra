{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mvp-oficina.local/schemas/contracts-lock.schema.json",
  "title": "MVP Oficina contract references lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["lock_version", "generated_at", "services"],
  "properties": {
    "$schema": {"type": "string"},
    "lock_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date"},
    "services": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "repository", "git_sha", "contracts_version", "artifacts"],
        "properties": {
          "service": {"type": "string", "pattern": "^mvp-oficina-(ordens|recursos|financeiro)$"},
          "repository": {"type": "string", "format": "uri"},
          "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "contracts_version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path", "sha256"],
              "properties": {
                "kind": {"enum": ["openapi", "json-schema", "example"]},
                "path": {"type": "string", "pattern": "^contracts/"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
